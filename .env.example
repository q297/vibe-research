# Copy to .env and adjust: cp .env.example .env

# Web UI port on the host
WEB_PORT=8080

# Public stand only (docker-compose.prod.yml): domain for HTTPS, e.g. 203.0.113.10.sslip.io
SITE_ADDRESS=

# Postgres with pgvector, shared with ingestion (role 2)
POSTGRES_DB=alfa_news
POSTGRES_USER=alfa
POSTGRES_PASSWORD=change-me-local-only

# true: serve synthetic fixtures instead of real modules of roles 2-4
MOCK_MODE=true
# true: no network and no LLM calls, snapshot and cache only
OFFLINE_MODE=false

# Long random string; empty means a per-process secret and logout on restart
JWT_SECRET=
JWT_TTL_MINUTES=720
# One password for all demo accounts; set it on a public stand, empty keeps users.json
DEMO_PASSWORD=
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Per-user hourly limits protecting the shared LLM budget
RATE_LIMIT_RUNS_PER_HOUR=30
RATE_LIMIT_CHAT_PER_HOUR=60
RATE_LIMIT_INGEST_PER_HOUR=10
# Failed logins per client IP
RATE_LIMIT_LOGIN_FAILURES_PER_HOUR=20
DAILY_TOKEN_LIMIT=

# Fake agent step delay in seconds, makes the live trace visible on demo
STUB_STEP_DELAY_S=0.4

# LLM gateway, used by role 4 once the access format is known
LLM_BASE_URL=
LLM_API_KEY=
