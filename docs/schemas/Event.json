{
  "$defs": {
    "ArticleRef": {
      "additionalProperties": false,
      "properties": {
        "article_id": {
          "description": "Hash of the canonical URL without utm params (D1)",
          "title": "Article Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "snippet": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        }
      },
      "required": [
        "article_id",
        "title",
        "source_name"
      ],
      "title": "ArticleRef",
      "type": "object"
    },
    "ClassificationStatus": {
      "enum": [
        "classified",
        "unclassified",
        "failed"
      ],
      "title": "ClassificationStatus",
      "type": "string"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Normalized name",
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "description": "company, person, country, commodity, regulator, other",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EventOrigin": {
      "enum": [
        "feed",
        "user_input",
        "synthetic"
      ],
      "title": "EventOrigin",
      "type": "string"
    },
    "SensitivityTag": {
      "enum": [
        "key_rate",
        "fx_rate",
        "inflation",
        "consumer_demand",
        "commodities_energy",
        "commodities_metals",
        "commodities_agri",
        "gold",
        "credit_market",
        "bond_market",
        "export_import",
        "sanctions",
        "regulation",
        "taxes",
        "logistics",
        "labor_market",
        "economic_growth",
        "real_estate",
        "other"
      ],
      "title": "SensitivityTag",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "description": "Bumped when the cluster changes (F2)",
      "title": "Version",
      "type": "integer"
    },
    "merged_into": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set when the event was merged",
      "title": "Merged Into"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Generated by a model, never a fact",
      "title": "Summary"
    },
    "event_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Type"
    },
    "tags": {
      "items": {
        "$ref": "#/$defs/SensitivityTag"
      },
      "title": "Tags",
      "type": "array"
    },
    "keywords": {
      "items": {
        "type": "string"
      },
      "title": "Keywords",
      "type": "array"
    },
    "okved_sections": {
      "description": "OKVED codes, '*' means the whole economy (D3)",
      "items": {
        "type": "string"
      },
      "title": "Okved Sections",
      "type": "array"
    },
    "countries": {
      "description": "ISO 3166-1 alpha-2 (D4)",
      "items": {
        "type": "string"
      },
      "title": "Countries",
      "type": "array"
    },
    "regions": {
      "description": "Russian regions as in client CSV",
      "items": {
        "type": "string"
      },
      "title": "Regions",
      "type": "array"
    },
    "importance": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Client-independent importance (D9)",
      "title": "Importance"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "classification_status": {
      "$ref": "#/$defs/ClassificationStatus",
      "default": "classified"
    },
    "origin": {
      "$ref": "#/$defs/EventOrigin",
      "default": "feed"
    },
    "taxonomy_version": {
      "default": "0.1.0",
      "title": "Taxonomy Version",
      "type": "string"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "articles": {
      "items": {
        "$ref": "#/$defs/ArticleRef"
      },
      "title": "Articles",
      "type": "array"
    }
  },
  "required": [
    "event_id",
    "title",
    "ingested_at",
    "updated_at"
  ],
  "title": "Event",
  "type": "object"
}
