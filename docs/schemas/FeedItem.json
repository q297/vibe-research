{
  "$defs": {
    "ClassificationStatus": {
      "enum": [
        "classified",
        "unclassified",
        "failed"
      ],
      "title": "ClassificationStatus",
      "type": "string"
    },
    "EventListItem": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "description": "Bumped when the cluster changes (F2)",
          "title": "Version",
          "type": "integer"
        },
        "merged_into": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when the event was merged",
          "title": "Merged Into"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Generated by a model, never a fact",
          "title": "Summary"
        },
        "event_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Type"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/SensitivityTag"
          },
          "title": "Tags",
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "okved_sections": {
          "description": "OKVED codes, '*' means the whole economy (D3)",
          "items": {
            "type": "string"
          },
          "title": "Okved Sections",
          "type": "array"
        },
        "countries": {
          "description": "ISO 3166-1 alpha-2 (D4)",
          "items": {
            "type": "string"
          },
          "title": "Countries",
          "type": "array"
        },
        "regions": {
          "description": "Russian regions as in client CSV",
          "items": {
            "type": "string"
          },
          "title": "Regions",
          "type": "array"
        },
        "importance": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Client-independent importance (D9)",
          "title": "Importance"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "classification_status": {
          "$ref": "#/$defs/ClassificationStatus",
          "default": "classified"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin",
          "default": "feed"
        },
        "taxonomy_version": {
          "default": "0.1.0",
          "title": "Taxonomy Version",
          "type": "string"
        },
        "source_count": {
          "default": 1,
          "title": "Source Count",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "title",
        "ingested_at",
        "updated_at"
      ],
      "title": "EventListItem",
      "type": "object"
    },
    "EventOrigin": {
      "enum": [
        "feed",
        "user_input",
        "synthetic"
      ],
      "title": "EventOrigin",
      "type": "string"
    },
    "InsightStatus": {
      "enum": [
        "pending",
        "running",
        "ready",
        "failed",
        "stale"
      ],
      "title": "InsightStatus",
      "type": "string"
    },
    "RelevanceReason": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "description": "Profile feature key, e.g. 'products.credit'",
          "title": "Feature",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tag": {
          "anyOf": [
            {
              "$ref": "#/$defs/SensitivityTag"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "feature",
        "label"
      ],
      "title": "RelevanceReason",
      "type": "object"
    },
    "SensitivityTag": {
      "enum": [
        "key_rate",
        "fx_rate",
        "inflation",
        "consumer_demand",
        "commodities_energy",
        "commodities_metals",
        "commodities_agri",
        "gold",
        "credit_market",
        "bond_market",
        "export_import",
        "sanctions",
        "regulation",
        "taxes",
        "logistics",
        "labor_market",
        "other"
      ],
      "title": "SensitivityTag",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event": {
      "$ref": "#/$defs/EventListItem"
    },
    "score": {
      "description": "Personal score, comparable only within one feed",
      "title": "Score",
      "type": "number"
    },
    "why_relevant": {
      "items": {
        "$ref": "#/$defs/RelevanceReason"
      },
      "title": "Why Relevant",
      "type": "array"
    },
    "insight_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/InsightStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Status of the cached insight for this pair, if any"
    }
  },
  "required": [
    "event",
    "score"
  ],
  "title": "FeedItem",
  "type": "object"
}
