{
  "$defs": {
    "Affiliate": {
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "title": "Client Id",
          "type": "string"
        },
        "link": {
          "description": "group or person",
          "title": "Link",
          "type": "string"
        },
        "shared_persons": {
          "default": 0,
          "title": "Shared Persons",
          "type": "integer"
        },
        "sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        }
      },
      "required": [
        "client_id",
        "link"
      ],
      "title": "Affiliate",
      "type": "object"
    },
    "ClientType": {
      "enum": [
        "active",
        "potential"
      ],
      "title": "ClientType",
      "type": "string"
    },
    "Counterparty": {
      "additionalProperties": false,
      "properties": {
        "counterparty_id": {
          "title": "Counterparty Id",
          "type": "string"
        },
        "okved_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Okved Code"
        },
        "okved_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Okved Name"
        },
        "sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector"
        },
        "role": {
          "description": "supplier or buyer",
          "title": "Role",
          "type": "string"
        },
        "share": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Share of payment volume",
          "title": "Share"
        },
        "payments_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payments Count"
        },
        "tags": {
          "description": "Sector tags of the counterparty, for 2nd-order impact",
          "items": {
            "$ref": "#/$defs/SensitivityTag"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "counterparty_id",
        "role"
      ],
      "title": "Counterparty",
      "type": "object"
    },
    "DataQuality": {
      "additionalProperties": false,
      "properties": {
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "completeness": {
          "default": 1.0,
          "description": "Share of key fields known",
          "maximum": 1,
          "minimum": 0,
          "title": "Completeness",
          "type": "number"
        }
      },
      "title": "DataQuality",
      "type": "object"
    },
    "DebtLoad": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "title": "DebtLoad",
      "type": "string"
    },
    "ExposureDirection": {
      "enum": [
        "risk",
        "opportunity",
        "mixed"
      ],
      "title": "ExposureDirection",
      "type": "string"
    },
    "ForeignTrade": {
      "additionalProperties": false,
      "properties": {
        "has_fea": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None means unknown, not 'no' (D8)",
          "title": "Has Fea"
        },
        "countries": {
          "description": "ISO 3166-1 alpha-2 (D4)",
          "items": {
            "type": "string"
          },
          "title": "Countries",
          "type": "array"
        },
        "country_names": {
          "description": "As written in FTS data",
          "items": {
            "type": "string"
          },
          "title": "Country Names",
          "type": "array"
        }
      },
      "title": "ForeignTrade",
      "type": "object"
    },
    "Product": {
      "enum": [
        "settlement",
        "guarantees",
        "credit",
        "leasing",
        "deposits",
        "payroll",
        "factoring"
      ],
      "title": "Product",
      "type": "string"
    },
    "Sensitivity": {
      "additionalProperties": false,
      "properties": {
        "tag": {
          "$ref": "#/$defs/SensitivityTag"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "reason": {
          "description": "Human readable, shown in the 'why relevant' chips",
          "title": "Reason",
          "type": "string"
        },
        "direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExposureDirection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "description": "Profile feature keys that produced the tag, e.g. 'products.credit' (crit. 12)",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "tag",
        "weight",
        "reason"
      ],
      "title": "Sensitivity",
      "type": "object"
    },
    "SensitivityTag": {
      "enum": [
        "key_rate",
        "fx_rate",
        "inflation",
        "consumer_demand",
        "commodities_energy",
        "commodities_metals",
        "commodities_agri",
        "gold",
        "credit_market",
        "bond_market",
        "export_import",
        "sanctions",
        "regulation",
        "taxes",
        "logistics",
        "labor_market",
        "economic_growth",
        "real_estate",
        "other"
      ],
      "title": "SensitivityTag",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "client_id": {
      "title": "Client Id",
      "type": "string"
    },
    "display_name": {
      "description": "Synthetic alias, data is anonymized",
      "title": "Display Name",
      "type": "string"
    },
    "okved_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Okved Code"
    },
    "okved_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Okved Name"
    },
    "sector": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Enlarged sector derived from OKVED",
      "title": "Sector"
    },
    "region": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Region"
    },
    "revenue_bn_rub": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revenue Bn Rub"
    },
    "client_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClientType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "company_age_years": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Midpoint of the gradation",
      "title": "Company Age Years"
    },
    "company_age_gradation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Raw value from CSV",
      "title": "Company Age Gradation"
    },
    "employees": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Midpoint of the gradation",
      "title": "Employees"
    },
    "employees_gradation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Employees Gradation"
    },
    "org_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Org Type"
    },
    "ownership_form": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "OKFS_NAME",
      "title": "Ownership Form"
    },
    "business_stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ECO_MARK_LABEL",
      "title": "Business Stage"
    },
    "key_owner_mark": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "NEGATIVEMARK",
      "title": "Key Owner Mark"
    },
    "group_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Group Id"
    },
    "city": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "City"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/Product"
      },
      "title": "Products",
      "type": "array"
    },
    "debt_load": {
      "anyOf": [
        {
          "$ref": "#/$defs/DebtLoad"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "foreign_trade": {
      "$ref": "#/$defs/ForeignTrade"
    },
    "sensitivities": {
      "items": {
        "$ref": "#/$defs/Sensitivity"
      },
      "title": "Sensitivities",
      "type": "array"
    },
    "top_counterparties": {
      "items": {
        "$ref": "#/$defs/Counterparty"
      },
      "title": "Top Counterparties",
      "type": "array"
    },
    "counterparty_concentration": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "HHI of payment volume over all counterparties",
      "title": "Counterparty Concentration"
    },
    "affiliates": {
      "items": {
        "$ref": "#/$defs/Affiliate"
      },
      "title": "Affiliates",
      "type": "array"
    },
    "data_quality": {
      "$ref": "#/$defs/DataQuality"
    }
  },
  "required": [
    "client_id",
    "display_name"
  ],
  "title": "ClientProfile",
  "type": "object"
}
